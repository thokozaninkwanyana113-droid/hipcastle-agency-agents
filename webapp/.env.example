# ---------------------------------------------------------------- Server
PORT=4000
NODE_ENV=production
# Required in production — a long random string
JWT_SECRET=replace-with-a-long-random-string
# Public URL of the site: canonical URLs, sitemap, llms.txt, email links and payment return URLs.
# Defaults to https://www.hipcastle.agency. In production, hipcastle.agency and http:// are 301-redirected here.
SITE_URL=https://www.hipcastle.agency
# SQLite file location (default: server/data/hipcastle.db)
DATABASE_PATH=./data/hipcastle.db
# First-boot admin account
ADMIN_EMAIL=admin@hipcastle.agency
ADMIN_PASSWORD=change-me-now
# Set to false to skip the demo client/engagement on first boot
SEED_DEMO=false
# Number of reverse proxies in front of the app (for correct client IPs)
TRUST_PROXY=1

# Set to true if your host/CDN already redirects hipcastle.agency → www
# DISABLE_HOST_REDIRECT=false

# ---------------------------------------------------------------- Email (SMTP)
# Any provider that can send as @hipcastle.agency: Google Workspace (smtp.gmail.com:465),
# Microsoft 365 (smtp.office365.com:587), Zoho Mail (smtp.zoho.com:465), Brevo, Amazon SES, cPanel…
# Without SMTP_HOST, emails are stored as "logged" and previewable in Command Centre → Emails.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); STARTTLS is used automatically on 587
SMTP_SECURE=false
SMTP_USER=hello@hipcastle.agency
SMTP_PASS=
# Optional override; defaults to "Hipcastle Agency" <hello@hipcastle.agency> from Settings
# EMAIL_FROM="Hipcastle Agency" <hello@hipcastle.agency>

# ---------------------------------------------------------------- Payments
# sandbox (default) or live
PAYMENTS_MODE=sandbox
# Where PayFast/Ozow can reach your server for notifications (defaults to SITE_URL).
# For local testing use a tunnel, e.g. https://your-tunnel.example
# PAYMENTS_NOTIFY_URL=

# PayFast — from your PayFast dashboard (Settings > Integration). Create a free
# sandbox account at sandbox.payfast.co.za to test notifications end to end.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Confirm every ITN with PayFast's validate endpoint (recommended: true)
PAYFAST_VALIDATE_REMOTE=true
# Check notifications come from PayFast's servers (defaults to true in live mode)
# PAYFAST_CHECK_IP=true

# Ozow — from Ozow merchant dashboard
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
# Optional: enables a server-to-server status double-check for each notification
OZOW_API_KEY=

# Simulated "test payment" option is available outside production unless disabled
# PAYMENTS_ALLOW_SIMULATED=false
