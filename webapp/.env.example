# ---------------------------------------------------------------- Server
PORT=4000
NODE_ENV=production
# Required in production — a long random string
JWT_SECRET=replace-with-a-long-random-string
# Public URL of the site: canonical URLs, sitemap, llms.txt, email links and payment return URLs.
# Defaults to https://www.hipcastle.agency. In production, hipcastle.agency and http:// are 301-redirected here.
SITE_URL=https://www.hipcastle.agency
# SQLite file location (default: server/data/hipcastle.db)
DATABASE_PATH=./data/hipcastle.db
# First-boot admin account
ADMIN_EMAIL=admin@hipcastle.agency
# Required in production (at least 10 characters) — the server refuses to start without it
ADMIN_PASSWORD=
# Set to false to skip the demo client/engagement on first boot
SEED_DEMO=false
# Number of reverse proxies in front of the app (for correct client IPs)
TRUST_PROXY=1

# Set to true if your host/CDN already redirects hipcastle.agency → www
# DISABLE_HOST_REDIRECT=false

# ---------------------------------------------------------------- Bot protection (optional)
# Cloudflare Turnstile on the contact, review and sign-up forms (free: dash.cloudflare.com → Turnstile).
# Leave empty to rely on the built-in honeypot and rate limits only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------- Email (SMTP)
# Any provider that can send as @hipcastle.agency: Google Workspace (smtp.gmail.com:465),
# Microsoft 365 (smtp.office365.com:587), Zoho Mail (smtp.zoho.com:465), Brevo, Amazon SES, cPanel…
# Without SMTP_HOST, emails are stored as "logged" and previewable in Command Centre → Emails.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); STARTTLS is used automatically on 587
SMTP_SECURE=false
SMTP_USER=hello@hipcastle.agency
SMTP_PASS=
# Optional override; defaults to "Hipcastle Agency" <hello@hipcastle.agency> from Settings
# EMAIL_FROM="Hipcastle Agency" <hello@hipcastle.agency>

# ---------------------------------------------------------------- Payments
# sandbox (default) or live
PAYMENTS_MODE=sandbox
# Where PayFast/Ozow can reach your server for notifications (defaults to SITE_URL).
# For local testing use a tunnel, e.g. https://your-tunnel.example
# PAYMENTS_NOTIFY_URL=

# PayFast — from your PayFast dashboard (Settings > Integration). Create a free
# sandbox account at sandbox.payfast.co.za to test notifications end to end.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Confirm every ITN with PayFast's validate endpoint (recommended: true)
PAYFAST_VALIDATE_REMOTE=true
# Check notifications come from PayFast's servers (defaults to true in live mode)
# PAYFAST_CHECK_IP=true

# Ozow — from Ozow merchant dashboard
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
# Optional: enables a server-to-server status double-check for each notification
OZOW_API_KEY=

# Simulated "test payment" option is available outside production unless disabled
# PAYMENTS_ALLOW_SIMULATED=false

# Website assistant ("Ask Hipcastle" on the homepage)
# Without a key the assistant runs in FAQ mode: instant answers from the built-in knowledge
# base, no AI cost. Add a Claude API key (console.anthropic.com) to switch on AI answers.
# Keep the key in your host's secret store, never in git.
ANTHROPIC_API_KEY=
# Model and effort (defaults: claude-opus-5-5, low). A smaller model such as claude-haiku-5-5
# costs less per conversation; the knowledge base is prompt-cached either way.
# CHATBOT_MODEL=claude-opus-5-5
# CHATBOT_EFFORT=low
# Force FAQ mode even when a key is present
# CHATBOT_AI=off

# Off-site backups (S3-compatible: AWS S3 af-south-1, Cloudflare R2, Backblaze B2). Strongly recommended.
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=af-south-1          # or "auto" for R2
# BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_S3_PREFIX=hipcastle/
# BACKUP_S3_KEEP=30

# Alerts: errors, crashed jobs and failed backups are emailed to notify_email; also post them to a
# Slack/Discord/Google Chat incoming webhook when set.
ALERT_WEBHOOK_URL=

# Xero accounting sync (Command Centre → Integrations → Connect Xero). Create a Web app at
# developer.xero.com with redirect URI <SITE_URL>/api/integrations/xero/callback.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# XERO_SCOPES=offline_access accounting.contacts accounting.invoices accounting.payments
