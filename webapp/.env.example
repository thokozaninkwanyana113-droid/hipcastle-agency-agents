# ---------------------------------------------------------------- Server
PORT=4000
NODE_ENV=production
# Required in production — a long random string
JWT_SECRET=replace-with-a-long-random-string
# Public URL of the site: canonical URLs, sitemap, llms.txt and payment return URLs
SITE_URL=https://www.hipcastle.co.za
# SQLite file location (default: server/data/hipcastle.db)
DATABASE_PATH=./data/hipcastle.db
# First-boot admin account
ADMIN_EMAIL=admin@hipcastle.co.za
ADMIN_PASSWORD=change-me-now
# Set to false to skip the demo client/engagement on first boot
SEED_DEMO=false
# Number of reverse proxies in front of the app (for correct client IPs)
TRUST_PROXY=1

# ---------------------------------------------------------------- Payments
# sandbox (default) or live
PAYMENTS_MODE=sandbox
# Where PayFast/Ozow can reach your server for notifications (defaults to SITE_URL).
# For local testing use a tunnel, e.g. https://your-tunnel.example
# PAYMENTS_NOTIFY_URL=

# PayFast — from your PayFast dashboard (Settings > Integration). Create a free
# sandbox account at sandbox.payfast.co.za to test notifications end to end.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Confirm every ITN with PayFast's validate endpoint (recommended: true)
PAYFAST_VALIDATE_REMOTE=true
# Check notifications come from PayFast's servers (defaults to true in live mode)
# PAYFAST_CHECK_IP=true

# Ozow — from Ozow merchant dashboard
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
# Optional: enables a server-to-server status double-check for each notification
OZOW_API_KEY=

# Simulated "test payment" option is available outside production unless disabled
# PAYMENTS_ALLOW_SIMULATED=false
