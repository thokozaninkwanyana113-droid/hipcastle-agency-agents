# --- Server ---
PORT=4000
NODE_ENV=production
# Required in production — use a long random string
JWT_SECRET=replace-with-a-long-random-string
# SQLite file location (default: server/data/hipcastle.db)
DATABASE_PATH=./data/hipcastle.db
# First-boot admin account
ADMIN_EMAIL=admin@hipcastle.agency
ADMIN_PASSWORD=change-me-now
# Set to false to skip demo client/engagement data on first boot
SEED_DEMO=false
# Comma-separated allowed origins (only needed if the client is hosted separately)
# CORS_ORIGIN=https://hipcastle.agency

# --- Client (build time) ---
# VITE_CURRENCY=USD
